# Bu dosyayı kopyalayıp adını .env yap ve değerleri doldur.
# .env git'e eklenmez (gizli bilgiler için), .env.example ise örnek olarak eklenir.

# https://formspree.io adresinde form oluşturunca verilen ID
# (ör. https://formspree.io/f/xabcdefg → xabcdefg)
NUXT_PUBLIC_FORMSPREE_ID=

# Sitenin yayındaki adresi (sonunda / olmadan). Canonical linkler, paylaşım görseli ve
# site haritası bu adresle oluşturulur. Vercel'e yükleyince gerçek adresi yaz.
NUXT_PUBLIC_SITE_URL=https://kisisel-site-rust.vercel.app
